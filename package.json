{
  "name": "tododesk",
  "productName": "TodoDesk",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "今日清单 · 专注当下，记录每一步",
  "author": "TodoDesk",
  "main": "dist-electron/main.cjs",
  "repository": "https://github.com/AnsoNeko/TodoDesk.git",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"{src,electron,shared,tests,scripts}/**/*.{ts,tsx,css,cjs}\"",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run typecheck && vite build && node scripts/build.cjs",
    "start": "electron .",
    "test:desktop": "node scripts/smoke.cjs",
    "test:install": "node scripts/installation-smoke.cjs",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "latest",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "tsx": "latest",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "local.tododesk.app",
    "productName": "TodoDesk",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "AnsoNeko",
      "repo": "TodoDesk",
      "private": false
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/icon.ico",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "executableName": "TodoDesk"
    },
    "nsis": {
      "artifactName": "TodoDesk-Setup-${version}-${arch}.${ext}",
      "include": "scripts/installer.nsh",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "今日清单 TodoDesk",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
